{
  "name": "erpos-desktop",
  "productName": "ERPOS",
  "version": "1.0.0",
  "description": "ERPOS para Windows — o sistema inteiro numa janela + bolinha flutuante com o painel rápido",
  "author": "ERPOS",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set ERPOS_URL=http://localhost:3000&& electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.erpos.desktop",
    "productName": "ERPOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "bubble.html",
      "bubble-preload.js",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERPOS",
      "artifactName": "ERPOS-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
